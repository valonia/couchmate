# Kopiera till .env och fyll i.

# Adress till Dispatcharr sett från sync-servern
XTREAM_URL=http://192.168.1.10:9191
# Xtream-inloggning (skapa en användare i Dispatcharr)
XTREAM_USER=synctv
XTREAM_PASS=hemligt

# PIN-kod som du och dina vänner anger i appen
ROOM_PIN=1234

# proxy  = appen hämtar strömmen via sync-servern (bara port 8787 behöver nås, inloggning syns inte)
# direct = appen hämtar direkt från Dispatcharr (då måste PUBLIC_XTREAM_URL kunna nås av alla)
STREAM_MODE=proxy
# PUBLIC_XTREAM_URL=http://min-domän.se:9191

# Filändelse för live-kanaler (ts fungerar bäst med Dispatcharr)
LIVE_EXT=ts
# Hur länge katalogen cachas (sekunder)
CACHE_SECONDS=300
# Max väntan (ms) på att alla ska ha buffrat innan uppspelningen startar ändå
START_TIMEOUT_MS=12000

# Delad film/serie-ström: filmen hämtas EN gång från Dispatcharr och delas ut till alla
# (en anslutning mot leverantören oavsett antal tittare). Kräver STREAM_MODE=proxy.
SHARED_VOD=true
# Var den tillfälliga filen sparas – behöver plats för en hel film (oftast 1–20 GB).
CACHE_DIR=/cache

# Var historiken sparas
DATA_DIR=/data

# Sammanslagen tablå (valfritt): originalet först, reservkällan fyller luckorna.
# Peka sedan EPG-källan i Dispatcharr på http://<server>:8787/epg/merged.xml.gz?pin=<PIN>
#EPG_PRIMARY_URL=http://leverantor/xmltv.php?username=...&password=...
#EPG_FALLBACK_COUNTRIES=auto
#EPG_FALLBACK_URL=
#EPG_MERGE_HOURS=3
#EPG_FALLBACK_MAP=originalid=reservid
